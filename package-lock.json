{
  "name": "remotelinkdesk",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "remotelinkdesk",
      "version": "0.1.0",
      "workspaces": [
        "shared/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@remotelinkdesk/protocol": {
      "resolved": "shared/protocol",
      "link": true
    },
    "node_modules/@remotelinkdesk/security": {
      "resolved": "shared/security",
      "link": true
    },
    "shared/protocol": {
      "name": "@remotelinkdesk/protocol",
      "version": "0.1.0"
    },
    "shared/security": {
      "name": "@remotelinkdesk/security",
      "version": "0.1.0"
    }
  }
}
